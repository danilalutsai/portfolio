{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/types(.*)$",
    "^@/composables(.*)$",
    "^@/stores(.*)$",
    "^@/data(.*)$",
    "^@/components(.*)$",
    "^@/(.*)$",
    "",
    "^[./]",
    "",
    "<TYPES>"
  ]
}
